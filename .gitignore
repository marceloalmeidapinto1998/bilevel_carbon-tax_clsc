__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

.venv*/
.vscode/

# .claude/ is NOT versioned. The multi-agent analysis framework it held (agents, workflows,
# standards, templates) was retired with the campaign_01 remap; what remains there is per-user
# local configuration, which does not belong in the repository.
.claude/

tmp_pytest_*.log

paper/*.aux
paper/*.log
paper/*.out

*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
texput.log

results/*
!results/README.md

# Analysis reports are versioned (markdown only, never solver output): the claim ledger's
# and the limitation register's history IS the audit trail for every number in the paper.
# Each level must be re-included explicitly -- git does not descend into an excluded directory.
!results/analysis/
results/analysis/*
!results/analysis/campaign_01/
results/analysis/campaign_01/*
!results/analysis/campaign_01/reports/
